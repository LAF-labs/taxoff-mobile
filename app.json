{
  "expo": {
    "name": "tex",
    "slug": "tex-mobile",
    "scheme": "tex",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "bundleIdentifier": "com.lafco.tex",
      "supportsTablet": false,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": true
      },
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      },
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "com.lafco.tex",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFC",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#181819"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "앱을 열 때 본인인지 확인해요"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "앱을 열 때 본인인지 확인해요"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "고른 사진만 읽어요. 앨범 전체를 올리지 않아요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PC 연결 QR과 종이 영수증을 찍을 때 카메라를 써요. 사진은 사진 앱에 저장하지 않아요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "./plugins/with-no-backup.cjs",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-asset",
      [
        "./plugins/with-display-name.cjs",
        {
          "name": "택스오프"
        }
      ]
    ],
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json"
    }
  }
}
